{
  "name": "orion",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/licenses.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-wasm.mjs",
    "mac": "node scripts/licenses.mjs && vite build && electron .",
    "mac:dev": "ORION_DEV_URL=http://localhost:5173 electron .",
    "mac:build": "node scripts/licenses.mjs && vite build && electron-builder --mac --dir",
    "mac:dmg": "node scripts/licenses.mjs && vite build && electron-builder --mac dmg",
    "android:build": "node scripts/licenses.mjs && vite build && cap sync android && cd android && JAVA_HOME=/opt/homebrew/opt/openjdk@21 ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../release/Orion-android.apk",
    "android:open": "cap open android",
    "licenses": "node scripts/licenses.mjs",
    "dist:mac": "node scripts/licenses.mjs && vite build && electron-builder --mac",
    "dist:win": "node scripts/licenses.mjs && vite build && electron-builder --win",
    "dist:linux": "node scripts/licenses.mjs && vite build && electron-builder --linux",
    "dist:all": "node scripts/licenses.mjs && vite build && electron-builder --mac --win --linux",
    "test": "vitest run",
    "test:app": "vite build && playwright test",
    "test:all": "vitest run && vite build && playwright test",
    "test:mac-app": "ORION_APP=release/mac-arm64/Orion.app/Contents/MacOS/Orion playwright test",
    "site:build": "node scripts/licenses.mjs && vite build --base=/app/ --outDir site-dist/app --emptyOutDir && node scripts/build-site.mjs",
    "site:preview": "npx --yes wrangler@4 pages dev site-dist",
    "android:release": "node scripts/licenses.mjs && vite build && cap sync android && cd android && JAVA_HOME=/opt/homebrew/opt/openjdk@21 ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../release/Orion-android.apk",
    "android:live": "node scripts/android-live.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "lucide-react": "^1.77.0",
    "mediabunny": "^1.66.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "description": "Free, open-source video editor. No account, no watermark — everything (AI included) runs on your computer.",
  "author": {
    "name": "Rafa Mendoza",
    "url": "https://github.com/rafa794"
  },
  "build": {
    "appId": "app.orion.editor",
    "productName": "Orion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "asarUnpack": [],
    "npmRebuild": false,
    "artifactName": "Orion-${os}-${arch}.${ext}",
    "dmg": {
      "title": "Orion ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Orion-Setup-${arch}.${ext}",
      "shortcutName": "Orion"
    },
    "portable": {
      "artifactName": "Orion-Portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Free video editor",
      "description": "Free, open-source video editor with local AI: cut, subtitles, background removal, stabilization and export.",
      "maintainer": "Rafa Mendoza <92345397+rafa794@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "license": "GPL-3.0-only",
  "homepage": "https://orion.rafael-mendoza.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafa794/orion.git"
  },
  "bugs": {
    "url": "https://github.com/rafa794/orion/issues"
  }
}
